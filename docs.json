  "logo": {
    "light": "/logo/hyperrail-logo-light.svg",
    "dark": "/logo/hyperrail-logo.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@hyperrails.io"
      },
      {
        "label": "Website",
        "href": "https://hyperrails.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "HyperRails Dashboard",
      "href": "https://app.hyperrails.io/"
    }
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#ffffff",
      "dark": "#000"
    }
  },
  "redirects": [
    {
      "source": "/guides/login",
      "destination": "/introduction"
    },
    {
      "source": "/get-started/guides/instant-trade",
      "destination": "/documentation/guides/take-a-quote-in-one-call"
    },
    {
      "source": "/get-started/concepts/rates-and-fees",
      "destination": "/get-started/concepts/quotes"
    },
    {
      "source": "/api-reference/ai/mcp",
      "destination": "/api-reference/ai/llms"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "go",
        "php",
        "java"
      ],
      "defaults": "all"
    },
    "mdx": {
      "auth": {
        "method": "bearer"
      },
      "server": "https://api.hyperrails.io/api/v1"
    },
    "openapi": "api-reference/openapi.json"
  }
}
